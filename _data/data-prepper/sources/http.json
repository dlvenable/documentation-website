{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ByteCount": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer"
        }
      }
    },
    "CompressionOption": {
      "type": "string",
      "enum": [
        "NONE",
        "GZIP",
        "SNAPPY",
        "ZSTD",
        "AUTOMATIC"
      ]
    },
    "PluginModel": {
      "type": "object",
      "properties": {
        "plugin_name": {
          "type": "string"
        }
      }
    }
  },
  "type": "object",
  "properties": {
    "acm_certificate_arn": {
      "type": "string"
    },
    "acm_certificate_timeout_millis": {
      "type": "integer",
      "minimum": 0
    },
    "acm_private_key_password": {
      "type": "string"
    },
    "authentication": {
      "$ref": "#/$defs/PluginModel"
    },
    "aws_region": {
      "type": "string"
    },
    "codec": {
      "$ref": "#/$defs/PluginModel"
    },
    "compression": {
      "$ref": "#/$defs/CompressionOption"
    },
    "health_check_service": {
      "type": "boolean"
    },
    "max_connection_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_pending_requests": {
      "type": "integer",
      "minimum": 0
    },
    "max_request_length": {
      "$ref": "#/$defs/ByteCount"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "request_timeout": {
      "type": "integer",
      "minimum": 2
    },
    "ssl": {
      "type": "boolean"
    },
    "ssl_certificate_file": {
      "type": "string"
    },
    "ssl_key_file": {
      "type": "string"
    },
    "thread_count": {
      "type": "integer",
      "minimum": 0
    },
    "unauthenticated_health_check": {
      "type": "boolean"
    },
    "use_acm_certificate_for_ssl": {
      "type": "boolean"
    }
  },
  "name": "http",
  "primary_fields": [],
  "documentation": "https://opensearch.org/docs/latest/data-prepper/pipelines/configuration/sources/http/"
}