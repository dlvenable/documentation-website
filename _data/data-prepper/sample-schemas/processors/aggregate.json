{
  "name": "aggregate",
  "plugin_type": "processor",
  "properties": {
    "identification_keys": {
      "type": "array",
      "required": true,
      "items": {
        "type": "string"
      }
    },
    "action": {
      "type": "object",
      "required": true,
      "properties": {
        "remove_duplicates": {
          "type": "object",
          "required": false
        },
        "put_all": {
          "type": "object",
          "required": false
        }
      }
    },
    "group_duration": {
      "type": "string",
      "required": false,
      "default": "180s"
    },
    "local_mode": {
      "type": "boolean",
      "required": false,
      "default": false
    }
  }
}