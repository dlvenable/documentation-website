#!/bin/bash

# Validation script for Data Prepper documentation
# Usage: ./_script/validate-docs

echo "🔍 Validating Data Prepper plugin documentation..."

# Run the simple validation script
ruby _script/validate-data-prepper-docs-simple.rb

exit_code=$?

if [ $exit_code -eq 0 ]; then
    echo "✅ Validation completed successfully!"
else
    echo "❌ Validation failed. Please fix the errors above."
fi

exit $exit_code